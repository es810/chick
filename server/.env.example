PORT=3000
NODE_ENV=development

# Option A — Local MongoDB (default for development)
MONGODB_URI=mongodb://127.0.0.1:27017/chicken_farm

# Option B — MongoDB Atlas (replace with your real cluster URI)
# MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/chicken_farm?retryWrites=true&w=majority

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
