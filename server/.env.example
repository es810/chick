PORT=3000
NODE_ENV=development

# MongoDB Atlas — use /chicken_farm database name (not empty path)
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER.mongodb.net/chicken_farm?retryWrites=true&w=majority

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# First admin (only when database has no users — used by server startup and npm run reset-db)
INITIAL_ADMIN_NAME=Admin
INITIAL_ADMIN_EMAIL=admin@chick.com
INITIAL_ADMIN_PASSWORD=change-me-to-a-strong-password
INITIAL_ADMIN_PHONE=

# Railway one-time wipe (optional): RESET_DB_ON_START=true or ALLOW_OPEN_BOOTSTRAP=true
